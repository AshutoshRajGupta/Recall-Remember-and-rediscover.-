PORT=5000

# CORS - the frontend origin allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Groq API (OpenAI-compatible chat completions) - used to generate the final
# RAG answer in POST /query. Get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Local embedding model (Groq has no embeddings endpoint) - runs in-process via
# @huggingface/transformers, downloaded and cached on first use.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# SQLite database file location
DB_PATH=./data/knowledge.db

# Retrieval tuning - untuned defaults, see README "Retrieval" section
TOP_K=5
SIMILARITY_THRESHOLD=0.3

# Retrieval tuning - untuned defaults, see README "Retrieval" section
TOP_K=5
SIMILARITY_THRESHOLD=0.3
